---
import { getEntry } from 'astro:content';
import StatusBadge from '../StatusBadge.astro';

const ids = [
  'meta-pacific',
  '05-blue-tick-ice',
  '09-digimune-indonesia',
  '01-soracha',
  '06-pt-transkon-jaya',
  '08-sinar-mas-land',
];
const items = await Promise.all(
  ids.map(async (id) => {
    const entry = await getEntry('work', id);
    if (!entry) {
      throw new Error(`SelectedWork.astro: Work id "${id}" not found — check for a typo or a renamed/removed entry.`);
    }
    return entry;
  })
);
---
<section id="selected-work">
  <div class="eyebrow">Selected Work</div>
  <h2 class="head">Selected projects.</h2>

  <div class="selected-list">
    {items.map((cs) => (
      <a href={`/work/${cs.id}/`} class="selected-card" data-cursor="VIEW" data-project-card>
        <div class="selected-card-content">
          <div class="selected-card-head">
            <span class="selected-card-org">{cs.data.organisation}</span>
            <StatusBadge status={cs.data.status} />
          </div>
          <p class="selected-card-role">{cs.data.role}</p>
          <p class="selected-card-desc">{cs.data.summary}</p>
          <span class="selected-card-link">View Work <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    ))}
  </div>

  <a href="/work/" class="selected-archive-link">See the full archive &rarr;</a>
</section>

<style>
.selected-list{display:flex;flex-direction:column;margin-bottom:28px;}
.selected-card{display:block;position:relative;border-top:1px solid var(--border);padding:28px 0;text-decoration:none;color:inherit;}
.selected-card:last-child{border-bottom:1px solid var(--border);}
.selected-card-content{display:grid;grid-template-columns:1.1fr 1fr 1.3fr 90px;gap:24px;align-items:start;}
.selected-card-head{display:flex;flex-direction:column;gap:12px;}.selected-card-org{font-size:clamp(23px,2.2vw,32px);letter-spacing:-.025em;line-height:1.2;}
.selected-card-role{font-size:14px;line-height:1.6;color:var(--text-dimmer);margin:0;}.selected-card-desc{font-size:15px;line-height:1.65;color:var(--text-dim);margin:0;max-width:50ch;}.selected-card-link{font-size:13px;justify-self:end;white-space:nowrap;}.selected-card-link span{display:inline-block;transition:transform .2s;}.selected-card:hover .selected-card-org{color:var(--accent);}.selected-card:hover .selected-card-link span{transform:translate(3px,-3px);}
.selected-archive-link{display:inline-block;font-size:15px;border-bottom:1px solid #666;padding-bottom:8px;text-decoration:none;}.selected-archive-link:hover{color:var(--accent);}
@media(max-width:1000px){.selected-card-content{grid-template-columns:1fr 1.4fr 80px;}.selected-card-role{grid-column:1;grid-row:2;}.selected-card-desc{grid-column:2;grid-row:1 / 3;}}
@media(max-width:600px){.selected-card-content{grid-template-columns:1fr auto;gap:14px;}.selected-card-desc{grid-column:1 / -1;grid-row:3;}.selected-card-role{grid-column:1 / -1;}.selected-card-link{grid-column:2;grid-row:1;}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;}}
</style>
