---
import { getCollection } from 'astro:content';
import CaseStudy from '../CaseStudy.astro';

const caseStudies = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---
<section id="work">
  <div class="eyebrow">Featured Work</div>
  <h2 class="head">The work, not the highlight reel.</h2>
  {caseStudies.map((cs) => <CaseStudy {...cs.data} />)}
</section>
