---
const steps = [
  { word: 'What', desc: "Review the existing work, speak with the team, and identify the problem." },
  { word: 'Matters', desc: 'Agree on priorities, scope, and the result the team needs.' },
  { word: 'Built', desc: "Build, test, document, and hand over the work." },
];
---
<section id="method">
  <div class="eyebrow">Method</div>
  <h2 class="head">How I approach a project.</h2>
  <div class="method-list">
    {steps.map((s) => (
      <div class="method-step">
        <span class="method-word">{s.word}</span>
        <p>{s.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .method-list{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;}
  @media (max-width:900px){.method-list{grid-template-columns:1fr;gap:24px;}}
  .method-word{display:block;font-family:var(--serif);font-size:24px;color:var(--accent);margin-bottom:10px;}
  .method-step p{font-size:15px;color:var(--text-dim);line-height:1.7;margin:0;max-width:38ch;}
</style>
