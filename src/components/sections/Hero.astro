---
import { getCollection } from 'astro:content';

// Hero evidence resolves to real Work routes by matching a stable content
// key (the project's title) against the actual collection at build time,
// rather than hand-typed slugs — so a route/filename change can't silently
// 404 the homepage again. Throws at build time if a title doesn't resolve.
const work = await getCollection('work');

function resolve(projectTitle: string) {
  const entry = work.find((w) => w.data.title === projectTitle);
  if (!entry) {
    throw new Error(`Hero.astro: no Work item found with title "${projectTitle}" — check for a typo or a renamed/removed entry.`);
  }
  return entry.id;
}

const rawStates = [
  { word: 'STRATEGIES', project: 'Sinar Mas Land', role: 'Certification & process gap analysis' },
  { word: 'CAMPAIGNS', project: 'Digimune Indonesia', role: 'Multi-brand marketing management' },
  { word: 'DIGITAL EXPERIENCES', project: 'Bauntung Digital', role: 'Digital presence strategy' },
  { word: 'OPERATIONS', project: 'Blue Tick Ice', role: 'Operations lead, six departments' },
  { word: 'SYSTEMS', project: 'PT Transkon Jaya', role: 'Fleet compliance & documentation systems' },
];

const states = rawStates.map((s) => ({ ...s, slug: resolve(s.project) }));
---
<section class="hero pointer-scene" id="hero">
  <div class="hero-meta hero-in d1">
    <span>Digital Marketing &amp; Business Systems Strategist</span>
    <span>Bali, Indonesia</span>
  </div>

  <div class="hero-orbit" data-depth="1.2" aria-hidden="true">
    <span>WHAT · MATTERS · BUILT · </span>
  </div>

  <div class="hero-main hero-in d2">
    <h1 id="hero-heading" aria-label={`I build ${states[0].word.toLowerCase()} around what matters.`}>
      <span class="hero-line"><span>I BUILD</span></span>
      <span class="hero-line hero-line-dynamic">
        <span class="hero-word" id="hero-word" data-states={JSON.stringify(states)}>{states[0].word}</span>
      </span>
      <span class="hero-line hero-line-final"><span>AROUND <em>WHAT MATTERS.</em></span></span>
    </h1>
  </div>

  <div class="hero-lower">
    <div class="hero-context hero-in d3">
      <p>I identify what matters before building what the business needs.</p>
      <p class="hero-context-sub">Working across growth, digital experience, operations, and business systems.</p>
    </div>

    <div class="hero-control hero-in d3">
      <span class="hero-control-label">Choose a capability</span>
      <div class="hero-capability-select" role="group" aria-label="Select a capability">
        {states.map((s, i) => (
          <button type="button" class="hero-cap-btn" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>{s.word}</button>
        ))}
      </div>
    </div>

    <a class="hero-evidence hero-in d4" id="hero-evidence" data-depth=".55" data-cursor="VIEW" href={`/work/${states[0].slug}/`}>
      <span class="hero-evidence-label">Evidence / selected work</span>
      <span class="hero-evidence-project" id="hero-evidence-project">{states[0].project}</span>
      <span class="hero-evidence-role" id="hero-evidence-role">{states[0].role}</span>
      <span class="hero-evidence-arrow" aria-hidden="true">↗</span>
    </a>
  </div>

  <a class="hero-scroll-hint hero-in d4" href="#selected-work">
    <span>Scroll to explore</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .hero{position:relative;overflow:hidden;padding-top:30px!important;padding-bottom:30px;isolation:isolate;}
  .hero-meta{display:flex;justify-content:space-between;gap:24px;border-top:1px solid var(--text);padding-top:9px;font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-dimmer);}
  .hero-main{position:relative;z-index:2;margin:auto 0;padding:8vh 0 6vh;}
  .hero-main h1{font-family:var(--sans);font-weight:400;font-size:clamp(52px,8.7vw,128px);line-height:.78;letter-spacing:-.075em;margin:0;text-transform:uppercase;}
  .hero-line{display:block;overflow:hidden;padding:.08em 0;}
  .hero-line>span{display:block;transform-origin:left bottom;animation:heroLineIn .95s cubic-bezier(.16,1,.3,1) both;}
  .hero-line:nth-child(2)>span{animation-delay:.1s;}
  .hero-line:nth-child(3)>span{animation-delay:.18s;}
  .hero-line-dynamic{padding-left:12vw;}
  .hero-line-final{font-size:.58em;letter-spacing:-.045em;padding-left:3vw;}
  .hero-line-final em{font-family:var(--serif);font-weight:400;text-transform:none;color:var(--accent);}
  .hero-word{font-family:var(--mono);font-weight:500;color:var(--accent);display:inline-block;transition:opacity .22s ease,transform .22s ease;white-space:nowrap;}
  .hero-word.transitioning{opacity:0;transform:translateY(16px);}
  @keyframes heroLineIn{from{transform:translateY(115%) rotate(2deg);}to{transform:translateY(0) rotate(0);}}

  .hero-orbit{position:absolute;right:3%;top:19%;width:clamp(130px,17vw,230px);aspect-ratio:1;border:1px solid var(--border);border-radius:50%;z-index:1;display:grid;place-items:center;transition:transform .18s ease-out;}
  .hero-orbit::after{content:"";width:22%;aspect-ratio:1;background:var(--accent);border-radius:50%;}
  .hero-orbit span{position:absolute;font-family:var(--mono);font-size:9px;letter-spacing:.12em;color:var(--text-faint);transform:rotate(-24deg);}

  .hero-lower{position:relative;z-index:3;display:grid;grid-template-columns:.85fr 1.35fr .9fr;gap:32px;align-items:end;border-top:1px solid var(--border);padding-top:18px;}
  .hero-context p{font-size:13px;color:var(--text-dim);line-height:1.55;margin:0 0 5px;max-width:34ch;}
  .hero-context .hero-context-sub{font-size:11px;color:var(--text-dimmer);}
  .hero-control-label{display:block;font-family:var(--mono);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:12px;}
  .hero-capability-select{display:flex;flex-wrap:wrap;gap:7px 14px;}
  .hero-cap-btn{font-family:var(--mono);font-size:9.5px;letter-spacing:.05em;color:var(--text-dimmer);background:transparent;border:0;padding:0 0 6px;cursor:pointer;position:relative;transition:color .15s ease;}
  .hero-cap-btn:hover,.hero-cap-btn:focus-visible,.hero-cap-btn[aria-pressed="true"]{color:var(--text);}
  .hero-cap-btn[aria-pressed="true"]::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--accent);}

  .hero-evidence{position:relative;display:block;text-decoration:none;color:inherit;border-left:2px solid var(--accent);padding:4px 28px 4px 16px;transition:transform .18s ease-out;}
  .hero-evidence-label{display:block;font-family:var(--mono);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:7px;}
  .hero-evidence-project{display:block;font-family:var(--mono);font-weight:500;font-size:15px;transition:color .2s ease;}
  .hero-evidence:hover .hero-evidence-project,.hero-evidence:focus-visible .hero-evidence-project{color:var(--accent);}
  .hero-evidence-role{display:block;font-size:11px;color:var(--text-dim);margin-top:5px;line-height:1.4;}
  .hero-evidence-arrow{position:absolute;right:0;top:50%;transform:translateY(-50%);color:var(--accent);font-size:18px;}

  .hero-scroll-hint{position:absolute;right:0;bottom:30px;display:flex;gap:12px;align-items:center;font-family:var(--mono);font-size:9px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:var(--text-faint);writing-mode:vertical-rl;}
  .hero-scroll-hint span:last-child{color:var(--accent);animation:scrollCue 1.6s ease-in-out infinite;}
  @keyframes scrollCue{50%{transform:translateY(5px);}}

  @media (max-width:1100px){
    .hero-main h1{font-size:clamp(48px,10vw,92px);}
    .hero-line-dynamic{padding-left:6vw;}
    .hero-lower{grid-template-columns:1fr 1fr;}
    .hero-context{grid-column:1/-1;}
    .hero-scroll-hint{display:none;}
  }
  @media (max-width:640px){
    .hero{display:block!important;min-height:100svh!important;padding-top:18px!important;padding-bottom:22px;}
    .hero-meta span:last-child{display:none;}
    .hero-main{padding:12vh 0 8vh;}
    .hero-main h1{font-size:clamp(43px,15.5vw,72px);line-height:.82;}
    .hero-line-dynamic{padding-left:0;}
    .hero-line-final{padding-left:0;font-size:.52em;line-height:.95;}
    .hero-word{white-space:normal;}
    .hero-orbit{right:-46px;top:24%;width:145px;}
    .hero-lower{grid-template-columns:1fr;gap:24px;}
    .hero-context{grid-column:auto;}
    .hero-evidence{border-left:0;border-top:2px solid var(--accent);padding:14px 28px 0 0;}
  }
  @media (prefers-reduced-motion:reduce){
    .hero-line>span{animation:none;}
    .hero-word,.hero-orbit,.hero-evidence{transition:none;}
    .hero-scroll-hint span:last-child{animation:none;}
  }
</style>

<script>
  import { trackEvent } from '../../scripts/analytics';

  const wordEl = document.getElementById('hero-word');
  const headingEl = document.getElementById('hero-heading');
  const evidenceLink = document.getElementById('hero-evidence') as HTMLAnchorElement | null;
  const projectEl = document.getElementById('hero-evidence-project');
  const roleEl = document.getElementById('hero-evidence-role');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.hero-cap-btn');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (wordEl) {
    const states = JSON.parse(wordEl.dataset.states ?? '[]') as { word: string; project: string; slug: string; role: string }[];
    let index = 0;
    let timer: number | undefined;

    function render(i: number) {
      const s = states[i];
      if (!wordEl || !evidenceLink || !projectEl || !roleEl) return;
      const apply = () => {
        wordEl.textContent = s.word;
        headingEl?.setAttribute('aria-label', `I build ${s.word.toLowerCase()} around what matters.`);
        evidenceLink.href = `/work/${s.slug}/`;
        projectEl.textContent = s.project;
        roleEl.textContent = s.role;
        wordEl.classList.remove('transitioning');
      };
      if (reduced) {
        apply();
      } else {
        wordEl.classList.add('transitioning');
        setTimeout(apply, 180);
      }
      buttons.forEach((b, bi) => b.setAttribute('aria-pressed', bi === i ? 'true' : 'false'));
    }

    function startAuto() {
      if (reduced) return;
      timer = window.setInterval(() => {
        index = (index + 1) % states.length;
        render(index);
      }, 3400);
    }

    // After a deliberate click, don't immediately fight the visitor by
    // auto-advancing away from what they just chose (PRD "P2 UI/UX
    // Remediation" section 46.2: pause long enough to read, restart after
    // ~6-10s of inactivity, not on the next tick).
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (timer) window.clearInterval(timer);
        index = Number(btn.dataset.index ?? 0);
        render(index);
        if (!reduced) timer = window.setTimeout(startAuto, 7000);
      });
    });

    startAuto();

    evidenceLink?.addEventListener('click', () => {
      const s = states[index];
      trackEvent('hero_evidence_click', { project: s.project, slug: s.slug });
    });
  }
</script>
