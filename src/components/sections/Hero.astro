---
const projects = [
 {name:'Meta Pacific',slug:'meta-pacific',role:'Brand direction & website',image:'/images/meta-pacific-brand-direction.png',alt:'Meta Pacific Look Again brand-direction poster'},
 {name:'Soracha',slug:'01-soracha',role:'Brand identity & photography',image:'/images/img-032-04d0bc24b4.jpeg',alt:'Soracha Creamy Clash brand campaign'},
 {name:'Digimune Indonesia',slug:'09-digimune-indonesia',role:'Multi-brand marketing',image:'/images/img-072-3cec2bbf67.jpeg',alt:'Campaign artwork from the Digimune Indonesia content archive'},
];
---
<section class="portfolio-hero" id="hero">
  <div class="hero-intro">
    <h1>What matters.<br /><span>Built.</span></h1>
    <div class="hero-description"><p>I'm Jerio. I work across brand identity, digital marketing, websites, and business operations.</p><a href="/work/">Explore my work <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="project-selector" role="group" aria-label="Select featured project">
    {projects.map((project,index)=><button type="button" aria-pressed={index===0?'true':'false'} data-project-index={index}><span>{String(index+1).padStart(2,'0')}</span>{project.name}</button>)}
  </div>
  <div class="project-stage">
    {projects.map((project,index)=><a class:list={['project-panel',index===0&&'is-selected']} href={`/work/${project.slug}/`} data-panel-index={index} aria-label={`View ${project.name}: ${project.role}`}>
      <div class="project-art"><img src={project.image} alt={project.alt} fetchpriority={index===0?'high':'auto'} decoding="async" /></div>
      <div class="project-caption"><div><h2>{project.name}</h2><p>{project.role}</p></div><span aria-hidden="true">↗</span></div>
    </a>)}
  </div>
</section>
<style>
  .portfolio-hero{padding-top:58px;padding-bottom:0;}
  .hero-intro{display:grid;grid-template-columns:1.5fr 1fr;align-items:end;gap:64px;margin-bottom:48px;}
  h1{font-size:clamp(58px,7.8vw,112px);line-height:1.02;letter-spacing:-.055em;font-weight:500;margin:0;}h1>span{color:var(--accent);}
  .hero-description{max-width:38ch;padding-bottom:6px;}.hero-description p{font-size:18px;line-height:1.65;color:var(--text-dim);margin:0 0 24px;}.hero-description a{display:inline-flex;gap:40px;font-size:14px;text-decoration:none;border-bottom:1px solid #666;padding-bottom:9px;}.hero-description a:hover{color:var(--accent);}
  .project-selector{display:flex;gap:30px;border-top:1px solid #333;padding-top:20px;margin-bottom:22px;}.project-selector button{display:flex;gap:12px;color:#a4a4a4;background:none;border:0;padding:0 0 8px;font-size:14px;cursor:pointer;transition:color .2s;}.project-selector button>span{font-size:11px;color:#888}.project-selector button[aria-pressed=true]{color:#fff;border-bottom:1px solid var(--accent);}
  .project-stage{display:flex;gap:20px;}.project-panel{flex:1;min-width:0;text-decoration:none;transition:flex .6s cubic-bezier(.2,.7,.2,1);}.project-panel.is-selected{flex:1.5;}
  .project-art{height:420px;overflow:hidden;background:#171717;}.project-art img{width:100%;height:100%;object-fit:contain;transition:transform .6s cubic-bezier(.2,.7,.2,1);}.project-panel:hover img{transform:scale(1.025)}
  .project-caption{display:flex;justify-content:space-between;gap:12px;padding-top:18px;}.project-caption h2{font-size:20px;font-weight:400;line-height:1.25;letter-spacing:-.02em;margin:0 0 6px}.project-caption p{font-size:13px;color:var(--text-dimmer);margin:0;line-height:1.5;}.project-caption>span{font-size:24px;transition:transform .2s}.project-panel:hover .project-caption>span{transform:translate(3px,-3px);color:var(--accent);}
  @media(max-width:1000px){.hero-intro{gap:40px;}.hero-description p{font-size:16px;}.project-art{height:330px;}.project-stage{gap:14px}.project-caption h2{font-size:17px;}}
  @media(max-width:700px){.hero-intro{grid-template-columns:1fr;gap:26px;margin-bottom:32px;}h1{font-size:clamp(46px,10.6vw,74px);letter-spacing:-.04em;}.hero-description{max-width:43ch;}.hero-description p{margin-bottom:18px;}.project-selector{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}.project-selector button{font-size:13px;gap:0;text-align:left;line-height:1.5;align-items:start;}.project-selector button>span{display:none;}.project-panel{display:none;}.project-panel.is-selected{display:block;}.project-art{height:auto;aspect-ratio:1/1;}.project-caption h2{font-size:22px;}.project-caption p{font-size:14px;}}
  @media(prefers-reduced-motion:reduce){*{transition:none!important;}.project-panel:hover img{transform:none;}}
</style>
<script>
  const buttons=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-project-index]'));
  const panels=Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-panel-index]'));
  function select(index:number){buttons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===index)));panels.forEach((panel,i)=>panel.classList.toggle('is-selected',i===index));}
  buttons.forEach((button,index)=>{button.addEventListener('click',()=>select(index));button.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();const next=(index+(event.key==='ArrowRight'?1:-1)+buttons.length)%buttons.length;select(next);buttons[next].focus();}});});
  panels.forEach((panel,index)=>{panel.addEventListener('pointerenter',()=>{if(window.matchMedia('(hover:hover)').matches)select(index);});panel.addEventListener('focus',()=>select(index));});
</script>
