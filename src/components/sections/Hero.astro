---
import { getCollection } from 'astro:content';
const work = await getCollection('work');
const rawStates = [
  { word: 'DIGITAL EXPERIENCES', project: 'Meta Pacific', role: 'Brand direction and website strategy' },
  { word: 'STRATEGY', project: 'Sinar Mas Land', role: 'Certification & process gap analysis' },
  { word: 'CAMPAIGNS', project: 'Digimune Indonesia', role: 'Multi-brand marketing management' },
  { word: 'OPERATIONS', project: 'Blue Tick Ice', role: 'Operations lead, six departments' },
  { word: 'SYSTEMS', project: 'PT Transkon Jaya', role: 'Fleet compliance & documentation systems' },
];
const states = rawStates.map((state) => {
  const entry = work.find((item) => item.data.title === state.project);
  if (!entry) throw new Error(`Hero.astro: no Work item found with title "${state.project}".`);
  const media = entry.data.media[0];
  return { ...state, slug: entry.id, image: media?.src ?? '', alt: media?.alt ?? '' };
});
---
<section class="hero" id="hero">
  <div class="hero-kicker hero-in d1"><span>Strategy / Design / Systems</span><span>Built around the work.</span></div>
  <div class="hero-stage">
    <div class="hero-copy hero-in d2">
      <h1 id="hero-heading" aria-label={`I build ${states[0].word} that matters.`}>
        <span>I build</span><span class="hero-word" id="hero-word" data-states={JSON.stringify(states)}>{states[0].word}</span><span>that matters.</span>
      </h1>
      <p>From unclear problems to work people can use. Strategy, marketing, digital experience, and operating systems.</p>
      <a class="hero-work-link" id="hero-work-link" href={`/work/${states[0].slug}/`} data-cursor="VIEW">Explore the project <span aria-hidden="true">↗</span></a>
    </div>
    <a class:list={['hero-visual hero-in d3', !states[0].image && 'no-image']} id="hero-evidence" href={`/work/${states[0].slug}/`} data-cursor="VIEW" aria-live="polite">
      <span class="hero-visual-stack" aria-hidden="true"></span>
      <img id="hero-image" src={states[0].image} alt={states[0].alt} fetchpriority="high" decoding="async" />
      <span class="hero-image-index" id="hero-image-index">01 / 05</span>
      <span class="hero-project"><small>Featured project</small><strong id="hero-evidence-project">{states[0].project}</strong><span id="hero-evidence-role">{states[0].role}</span></span>
    </a>
    <div class="hero-selector hero-in d4" role="group" aria-label="Select a capability">
      {states.map((state, index) => <button type="button" class="hero-cap-btn" data-index={index} aria-pressed={index === 0 ? 'true' : 'false'}><span class="selector-dot" aria-hidden="true"></span><span>{state.word}</span></button>)}
    </div>
  </div>
  <div class="hero-foot hero-in d4"><span>Digital Marketing &amp; Business Systems Strategist</span><span>Bali, Indonesia</span></div>
</section>
<style>
  .hero{min-height:100vh;justify-content:space-between!important;padding:30px 0 24px!important;overflow:hidden;}
  .hero-kicker,.hero-foot{display:flex;justify-content:space-between;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--text-faint);}
  .hero-stage{display:grid;grid-template-columns:minmax(340px,.9fr) minmax(390px,1.25fr) minmax(150px,.5fr);align-items:center;gap:34px;margin:auto 0;width:100%;}
  .hero-copy{position:relative;z-index:3;}
  .hero-copy h1{display:flex;flex-direction:column;font-size:clamp(52px,5vw,72px);font-weight:500;line-height:.86;letter-spacing:-.07em;margin:0 0 34px;}
  .hero-word{max-width:9.5ch;overflow-wrap:normal;}
  .hero-word{color:var(--accent);transition:opacity .28s ease,transform .28s ease;}.hero-word.transitioning{opacity:0;transform:translateY(12px);}
  .hero-copy p{max-width:34ch;font-size:14px;line-height:1.65;color:var(--text-dim);margin:0 0 28px;}
  .hero-work-link{display:inline-flex;gap:42px;align-items:center;font-size:11px;text-transform:uppercase;letter-spacing:.08em;text-decoration:none;border-bottom:1px solid var(--text);padding-bottom:7px;}.hero-work-link span{transition:transform .2s ease}.hero-work-link:hover span{transform:translate(3px,-3px)}
  .hero-visual{position:relative;z-index:2;display:block;aspect-ratio:1.28/1;color:white;background:#191816;text-decoration:none;transform-style:preserve-3d;transition:transform .45s cubic-bezier(.2,.8,.2,1),opacity .25s ease;}
  .hero-visual::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 44%,rgba(0,0,0,.72));pointer-events:none}.hero-visual.transitioning{opacity:.18;transform:translateY(10px) scale(.985)}
  .hero-visual-stack{position:absolute;inset:-28px 5% 28px -4%;border:1px solid var(--border);transform:translateZ(-1px) rotate(-3deg);background:var(--surface)}.hero-visual-stack::after{content:"";position:absolute;inset:12px -22px -12px 22px;border:1px solid var(--border);background:var(--bg);z-index:-1}
  .hero-visual img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.05);transition:transform .6s cubic-bezier(.2,.8,.2,1)}.hero-visual:hover img{transform:scale(1.025)}
  .hero-visual.no-image img{opacity:0}.hero-visual.no-image::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,transparent 0 34px,rgba(255,255,255,.035) 34px 35px);}
  .hero-image-index{position:absolute;z-index:2;right:18px;top:16px;font-size:10px;letter-spacing:.14em}.hero-project{position:absolute;z-index:2;left:22px;right:22px;bottom:20px;display:grid;grid-template-columns:1fr auto;align-items:end;gap:5px 18px}.hero-project small{grid-column:1/-1;text-transform:uppercase;letter-spacing:.14em;font-size:9px;opacity:.7}.hero-project strong{font-size:clamp(23px,2.4vw,36px);font-weight:500;letter-spacing:-.04em}.hero-project>span{max-width:24ch;text-align:right;font-size:11px;line-height:1.4;color:rgba(255,255,255,.75)}
  .hero-selector{position:relative;display:flex;flex-direction:column;padding-left:28px}.hero-selector::before{content:"";position:absolute;left:5px;top:15px;bottom:15px;width:1px;background:var(--border)}
  .hero-cap-btn{position:relative;display:flex;align-items:center;gap:18px;border:0;background:none;padding:15px 0;color:var(--text-dimmer);text-align:left;font-family:var(--sans);font-size:10px;line-height:1.25;letter-spacing:.05em;cursor:pointer;transition:color .2s ease,transform .2s ease}.hero-cap-btn:hover{color:var(--text);transform:translateX(4px)}
  .selector-dot{position:absolute;left:-28px;width:9px;height:9px;border:1px solid var(--text-dimmer);border-radius:50%;background:var(--bg);transition:background .2s,border-color .2s,transform .2s}.hero-cap-btn[aria-pressed="true"]{color:var(--accent);font-weight:500}.hero-cap-btn[aria-pressed="true"] .selector-dot{background:var(--accent);border-color:var(--accent);transform:scale(1.25);box-shadow:0 0 0 4px var(--bg),0 0 0 5px var(--accent)}.hero-cap-btn[aria-pressed="true"]::before{content:"";position:absolute;right:calc(100% + 28px);width:42px;height:1px;background:var(--accent)}
  @media(max-width:1180px){.hero-stage{grid-template-columns:.8fr 1.2fr}.hero-selector{grid-column:1/-1;flex-direction:row;padding:0;flex-wrap:wrap}.hero-selector::before,.selector-dot,.hero-cap-btn[aria-pressed="true"]::before{display:none}.hero-cap-btn{padding:8px 12px 8px 0}.hero-copy h1{font-size:clamp(48px,7vw,78px)}}
  @media(max-width:760px){.hero{padding:22px 0 18px!important}.hero-kicker span:last-child{display:none}.hero-stage{grid-template-columns:1fr;gap:30px;margin:42px 0}.hero-copy h1{font-size:clamp(46px,14vw,66px);line-height:.9;white-space:normal;margin-bottom:24px}.hero-copy p{font-size:13px}.hero-visual{aspect-ratio:1.08/1}.hero-visual-stack{inset:-14px 5% 14px -2%}.hero-project{left:16px;right:16px;bottom:15px}.hero-project>span{display:none}.hero-selector{order:-1;overflow-x:auto;flex-wrap:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch}.hero-selector::-webkit-scrollbar{display:none}.hero-cap-btn{white-space:nowrap}.hero-foot{line-height:1.5;flex-direction:column;gap:3px}}
  @media(prefers-reduced-motion:reduce){.hero-word,.hero-visual,.hero-visual img,.hero-cap-btn,.hero-work-link span{transition:none!important}.hero-visual:hover img{transform:none}}
</style>
<script>
  import { trackEvent } from '../../scripts/analytics';
  const wordEl=document.getElementById('hero-word'),headingEl=document.getElementById('hero-heading'),visual=document.getElementById('hero-evidence') as HTMLAnchorElement|null,workLink=document.getElementById('hero-work-link') as HTMLAnchorElement|null,imageEl=document.getElementById('hero-image') as HTMLImageElement|null,projectEl=document.getElementById('hero-evidence-project'),roleEl=document.getElementById('hero-evidence-role'),imageIndex=document.getElementById('hero-image-index'),buttons=document.querySelectorAll<HTMLButtonElement>('.hero-cap-btn');
  const reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches,finePointer=window.matchMedia('(pointer:fine)').matches;
  if(wordEl&&visual&&workLink&&imageEl&&projectEl&&roleEl&&imageIndex){
    const states=JSON.parse(wordEl.dataset.states??'[]') as {word:string;project:string;slug:string;role:string;image:string;alt:string}[];let active=0,timer:number|undefined;
    const apply=(index:number)=>{const state=states[index];wordEl.textContent=state.word;imageEl.src=state.image;imageEl.alt=state.alt;visual.classList.toggle('no-image',!state.image);visual.href=workLink.href=`/work/${state.slug}/`;projectEl.textContent=state.project;roleEl.textContent=state.role;imageIndex.textContent=`${String(index+1).padStart(2,'0')} / ${String(states.length).padStart(2,'0')}`;headingEl?.setAttribute('aria-label',`I build ${state.word} that matters.`);wordEl.classList.remove('transitioning');visual.classList.remove('transitioning')};
    const render=(index:number)=>{active=index;buttons.forEach((button,i)=>button.setAttribute('aria-pressed',i===index?'true':'false'));if(reduced)apply(index);else{wordEl.classList.add('transitioning');visual.classList.add('transitioning');window.setTimeout(()=>apply(index),180)}};
    const start=()=>{if(!reduced)timer=window.setInterval(()=>render((active+1)%states.length),4200)};
    buttons.forEach(button=>button.addEventListener('click',()=>{if(timer)clearInterval(timer);render(Number(button.dataset.index));timer=window.setTimeout(start,8000)}));
    if(!reduced&&finePointer){visual.addEventListener('pointermove',(event)=>{const box=visual.getBoundingClientRect(),x=(event.clientX-box.left)/box.width-.5,y=(event.clientY-box.top)/box.height-.5;visual.style.transform=`perspective(900px) rotateX(${-y*3}deg) rotateY(${x*4}deg) translateY(-3px)`});visual.addEventListener('pointerleave',()=>visual.style.transform='')}
    visual.addEventListener('click',()=>trackEvent('hero_evidence_click',{project:states[active].project,slug:states[active].slug}));start();
  }
</script>
