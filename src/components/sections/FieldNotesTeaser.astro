---
import { getCollection } from 'astro:content';

const articles = (await getCollection('field-notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
---
<section id="field-notes">
  <div class="eyebrow">Field Notes</div>
  <h2 class="head">From the notebook.</h2>
  {articles.length === 0 ? (
    <p class="writing-empty">Nothing published yet, first pieces are in progress. <a href="/field-notes/">Check the Field Notes archive</a> for when that changes.</p>
  ) : (
    <div class="writing-teaser-list">
      {articles.map((a) => (
        <a href={`/field-notes/${a.id}/`} class="writing-teaser-card" data-cursor="READ">
          <span class="writing-teaser-category">{a.data.category}</span>
          <span class="writing-teaser-title">{a.data.title}</span>
          <p class="writing-teaser-desc">{a.data.description}</p>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .writing-empty{font-size:14px;color:var(--text-dim);line-height:1.7;max-width:52ch;}
  .writing-empty a{color:var(--accent);border-bottom:1px solid var(--accent);text-decoration:none;}
  .writing-teaser-list{display:flex;flex-direction:column;}
  @media (max-width:900px){.writing-teaser-list{grid-template-columns:1fr;}}
  .writing-teaser-card{display:grid;grid-template-columns:110px 1.2fr 1fr;gap:32px;background:transparent;border:0;border-top:1px solid var(--border);border-radius:0;padding:28px 0;text-decoration:none;color:inherit;}
  .writing-teaser-category{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);}
  .writing-teaser-title{display:block;font-family:var(--serif);font-size:23px;line-height:1.3;letter-spacing:-.025em;margin:0;}
  .writing-teaser-desc{font-size:15px;color:var(--text-dim);margin:0;line-height:1.6;}
@media(max-width:800px){.writing-teaser-card{grid-template-columns:1fr;gap:12px;}}
</style>
