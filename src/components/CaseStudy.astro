---
import StatusBadge from './StatusBadge.astro';
import ArchiveBlock from './ArchiveBlock.astro';

interface Props {
  order: number;
  title: string;
  status: 'delivered' | 'ongoing';
  situation: string;
  decision: string;
  moved: string;
  lesson: string;
  archive?: { title: string; groups: { label: string; thumbs: { src: string; alt: string }[] }[] };
}
const { order, title, status, situation, decision, moved, lesson, archive } = Astro.props;
const num = String(order).padStart(2, '0');
---
<div class="case">
  <div class="case-num">{num}</div>
  <div>
    <div class="case-head">
      <div class="case-title">{title}</div>
      <StatusBadge status={status} />
    </div>
    <div class="case-block"><div class="lbl">Situation</div><p>{situation}</p></div>
    <div class="case-block"><div class="lbl">Decision</div><p>{decision}</p></div>
    <div class="case-block"><div class="lbl">Moved</div><p>{moved}</p></div>
    <div class="case-block lesson"><p>{lesson}</p></div>
    {archive && <ArchiveBlock title={archive.title} groups={archive.groups} />}
  </div>
</div>
