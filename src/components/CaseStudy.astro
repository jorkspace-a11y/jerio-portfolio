---
import StatusBadge from './StatusBadge.astro';
import ArchiveBlock from './ArchiveBlock.astro';

interface Props {
  order: number;
  title: string;
  status: 'delivered' | 'ongoing';
  situation: string;
  decision: string;
  moved: string;
  lesson?: string;
  archives?: { title: string; groups: { label: string; thumbs: { src: string; alt: string }[] }[] }[];
}
const { order, title, status, situation, decision, moved, lesson, archives = [] } = Astro.props;
const num = String(order).padStart(2, '0');
---
<div class="case">
  <div class="case-num">{num}</div>
  <div>
    <div class="case-head">
      <div class="case-title">{title}</div>
      <StatusBadge status={status} />
    </div>
    <div class="case-block"><div class="lbl">Context</div><p>{situation}</p></div>
    <div class="case-block"><div class="lbl">What &amp; Matters</div><p>{decision}</p></div>
    <div class="case-block"><div class="lbl">Built</div><p>{moved}</p></div>
    {lesson && <div class="case-block lesson"><p>{lesson}</p></div>}
    {archives.map((a) => <ArchiveBlock title={a.title} groups={a.groups} />)}
  </div>
</div>
