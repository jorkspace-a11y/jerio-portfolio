---
const links = [
  { href: '/work/', label: 'Work.' },
  { href: '/studies/', label: 'Studies.' },
  { href: '/services/', label: 'Services.' },
  { href: '/field-notes/', label: 'Field Notes.' },
  { href: '/resources/', label: 'Resources.' },
  { href: '/about/', label: 'About.' },
];
---
<nav class="rail">
  <div>
    <a href="/" class="rail-name">Jerio<span>.</span></a>
    <div class="rail-nav">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/#contact" class="rail-cta" data-cursor="TALK">Start a Project</a>
    </div>
  </div>
  <div>
    <div class="rail-legend">
      <div><span class="dot" style="background:#3E5D4C;"></span>Delivered</div>
      <div><span class="dot" style="background:#8A6512;"></span>Ongoing</div>
    </div>
    <div class="rail-foot" style="margin-top:20px;">Bali, Indonesia</div>
  </div>
</nav>
