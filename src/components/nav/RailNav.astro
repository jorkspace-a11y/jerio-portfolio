---
const links = [
  { href: '/', label: 'Home.' },
  { href: '/work/', label: 'Work.' },
  { href: '/writing/', label: 'Writing.' },
  { href: '/about/', label: 'About.' },
  { href: '/#contact', label: 'Talk to me.' },
];
---
<nav class="rail">
  <div>
    <a href="/" class="rail-name">Jerio<span>.</span></a>
    <div class="rail-nav">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>
  <div>
    <div class="rail-legend">
      <div><span class="dot" style="background:#3E5D4C;"></span>Delivered</div>
      <div><span class="dot" style="background:#8A6512;"></span>Ongoing</div>
    </div>
    <div class="rail-foot" style="margin-top:20px;">Bali, Indonesia</div>
  </div>
</nav>
