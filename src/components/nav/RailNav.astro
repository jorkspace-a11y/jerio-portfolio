---
const links = [
  { href: '/work/', label: 'Work', marked: true },
  { href: '/services/', label: 'Services', marked: true },
  { href: '/studies/', label: 'Studies', marked: true },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/resources/', label: 'Resources' },
  { href: '/about/', label: 'About', marked: true },
];
---
<nav class="rail">
  <div>
    <a href="/" class="rail-name">Jerio<span>.</span></a>
    <div class="rail-nav">
      {links.map((l) => <a href={l.href}><span>{l.label}</span>{l.marked && <span class="nav-chevron" aria-hidden="true">⌄</span>}</a>)}
      <a href="/#contact" class="rail-cta" data-cursor="TALK"><span>Start a Project</span><span aria-hidden="true">↗</span></a>
    </div>
  </div>
</nav>
