---
const links = [
  { href: '/', label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/field-notes/', label: 'Field Notes' },
  { href: '/services/', label: 'Services' },
  { href: '/resources/', label: 'Resources' },
];
---
<nav class="rail">
  <div>
    <a href="/" class="rail-name">Jerio<span>.</span></a>
    <div class="rail-nav">
      {links.map((l, index) => <a href={l.href}><span class="rail-index">{String(index + 1).padStart(2, '0')}</span><span>{l.label}</span></a>)}
      <a href="/#contact" class="rail-cta" data-cursor="TALK"><span>Start a Project</span><span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div>
    <div class="rail-legend">
      <div><span class="dot" style="background:#3E5D4C;"></span>Delivered</div>
      <div><span class="dot" style="background:#8A6512;"></span>Ongoing</div>
    </div>
    <div class="rail-foot" style="margin-top:20px;">Bali, Indonesia</div>
  </div>
</nav>
