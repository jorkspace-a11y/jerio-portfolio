---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailNav from '../../components/nav/RailNav.astro';
import MobileBar from '../../components/nav/MobileBar.astro';
import { StackSmokeTest } from '../../components/lab/StackSmokeTest';
---
<BaseLayout title="Lab | Jerio" description="Experiments, prototypes, and small utilities — validated ones graduate into Resources or Products.">
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <section id="lab-index" style="padding-top:64px;">
        <div class="eyebrow">Lab</div>
        <h1 class="head">Nothing shipped here yet.</h1>
        <p class="lab-empty">The Lab is for experiments — calculators, prototypes, small tools — that graduate into <a href="/resources/">Resources</a> or <a href="/products/">Products</a> once they prove useful. The <a href="/resources/calculators/roas-calculator/">ROAS calculator</a> started this way. Below is the first thing running on the new interactive stack, not a product, a proof that React, Tailwind, shadcn/ui, and Motion are actually wired together correctly.</p>
        <div class="lab-smoke-test">
          <StackSmokeTest client:load />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .lab-empty{font-size:14px;color:var(--text-dim);line-height:1.75;max-width:56ch;margin-bottom:28px;}
  .lab-empty a{color:var(--accent);border-bottom:1px solid var(--accent);text-decoration:none;}
  .lab-smoke-test{max-width:520px;}
</style>
