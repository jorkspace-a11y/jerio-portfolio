---
import BaseLayout from '../layouts/BaseLayout.astro';
import RailNav from '../components/nav/RailNav.astro';
import MobileBar from '../components/nav/MobileBar.astro';
import Hero from '../components/sections/Hero.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import Method from '../components/sections/Method.astro';
import Experience from '../components/sections/Experience.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import WritingTeaser from '../components/sections/WritingTeaser.astro';
import Contact from '../components/sections/Contact.astro';
---
<BaseLayout>
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <Hero />
      <SelectedWork />
      <Method />
      <Experience />
      <AboutTeaser />
      <WritingTeaser />
      <Contact />
    </main>
  </div>
</BaseLayout>
