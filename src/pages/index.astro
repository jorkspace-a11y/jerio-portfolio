---
import BaseLayout from '../layouts/BaseLayout.astro';
import RailNav from '../components/nav/RailNav.astro';
import MobileBar from '../components/nav/MobileBar.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Work from '../components/sections/Work.astro';
import Gallery from '../components/sections/Gallery.astro';
import Contact from '../components/sections/Contact.astro';
---
<BaseLayout>
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <Hero />
      <About />
      <Capabilities />
      <Work />
      <Gallery />
      <Contact />
    </main>
  </div>
</BaseLayout>
