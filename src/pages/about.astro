---
import BaseLayout from '../layouts/BaseLayout.astro';
import RailNav from '../components/nav/RailNav.astro';
import MobileBar from '../components/nav/MobileBar.astro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: 'Jerio',
    jobTitle: 'Digital Marketing & Business Systems Strategist',
    url: 'https://whatmattersbuilt.co/',
    sameAs: ['https://www.linkedin.com/in/jerio-jerio/'],
  },
};
---
<BaseLayout title="About | Jerio" description="Jerio is a digital marketing and business systems strategist based in Bali, Indonesia, working across growth, digital experience, and operations.">
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <section id="about-page">
        <div class="eyebrow">About</div>
        <div class="about-layout">
          <h1>I work where strategy meets the reality of running a business.</h1>
          <div class="about">
            <p class="about-lead">Marketing work that ignores operations produces plans nobody can execute. Operations work that ignores marketing produces systems nobody outside the business understands.</p>
            <p>I build brand identity and run digital marketing for founders without an internal team. I started the practice in 2023 in East Kalimantan, first as <strong>WWJ</strong>, then <strong>Matari.allo</strong>, before it became <strong>Allo.Society</strong>.</p>
            <p>Before that, I ran paid media and CRM for other people's clients: 88 Meta Ads campaigns across four brands at Dream Box, a HubSpot sequence at KKBC that reached a 14.4% click-through rate, and a brand launched to page-one Google rankings at RevoU.</p>
            <p>I also spent years running physical operations, fleets, factories, and compliance systems across East and South Kalimantan before Blue Tick Ice brought me to Bali. That is why the marketing here is built to hold up under scrutiny.</p>
            <p>Allo.Society is a separate company I founded. This site is my own record of the work, across whichever side of the growth-and-operations line it happened to sit on.</p>
          </div>
        </div>
        <div class="about-links">
          <a href="/work/">See the work</a>
          <a href="/#contact">Talk to me</a>
        </div>
      </section>
    </main>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
</BaseLayout>

<style>
  #about-page{min-height:auto;padding:110px 0 150px;display:block;max-width:1240px;margin:0 auto;}
  .about-layout{display:grid;grid-template-columns:minmax(320px,.9fr) minmax(420px,1.1fr);gap:clamp(70px,10vw,160px);align-items:start;}
  .about-layout h1{font-size:clamp(54px,6.5vw,96px);line-height:.92;letter-spacing:-.065em;font-weight:500;margin:0;max-width:9ch;}
  .about{padding-top:8px;}
  .about p{font-size:16px;line-height:1.75;max-width:58ch;margin:0 0 28px;color:var(--text-dim);}
  .about .about-lead{font-size:21px;line-height:1.55;color:var(--text);}
  .about-links{display:flex;gap:28px;margin-top:36px;}
  .about-links a{font-family:var(--mono);font-size:13px;text-decoration:none;color:var(--text-dim);border-bottom:1px solid var(--border);padding-bottom:2px;transition:color .15s ease,border-color .15s ease;}
  .about-links a:hover{color:var(--accent);border-color:var(--accent);}
  @media(max-width:800px){#about-page{padding:72px 0 100px}.about-layout{grid-template-columns:1fr;gap:44px}.about-layout h1{font-size:clamp(48px,13vw,70px)}.about p{font-size:15px}.about .about-lead{font-size:18px}}
</style>
