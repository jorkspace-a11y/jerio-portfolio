---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailNav from '../../components/nav/RailNav.astro';
import MobileBar from '../../components/nav/MobileBar.astro';

export async function getStaticPaths() {
  const articles = await getCollection('field-notes', ({ data }) => !data.draft);
  return articles.map((a) => ({ params: { slug: a.id }, props: { a } }));
}

const { a } = Astro.props;
const { Content } = await render(a);
const { title, description, author, publishedAt, updatedAt, category, relatedWork, relatedServices, relatedResources } = a.data;

const wordCount = a.body?.split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const workLinks = await Promise.all(relatedWork.map(async (id) => {
  const entry = await getEntry('case-studies', id);
  if (!entry) throw new Error(`Field note "${a.id}" references unknown case study id "${id}"`);
  return { href: `/work/${entry.id}/`, label: entry.data.title };
}));

const allServices = await getCollection('services');
const serviceLinks = relatedServices.map((slug) => {
  const entry = allServices.find((s) => s.data.slug === slug);
  if (!entry) throw new Error(`Field note "${a.id}" references unknown service slug "${slug}"`);
  return { href: `/services/${entry.data.slug}/`, label: entry.data.title };
});

const allResources = await getCollection('resources');
const resourceLinks = relatedResources.map((slug) => {
  const entry = allResources.find((r) => r.data.slug === slug);
  if (!entry) throw new Error(`Field note "${a.id}" references unknown resource slug "${slug}"`);
  return { href: `/resources/${entry.data.type}s/${entry.data.slug}/`, label: entry.data.title };
});

const relatedLinks = [...workLinks, ...serviceLinks, ...resourceLinks];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  author: { '@type': 'Person', name: author },
  datePublished: publishedAt.toISOString(),
  dateModified: (updatedAt ?? publishedAt).toISOString(),
  url: `https://whatmattersbuilt.co/field-notes/${a.id}/`,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Field Notes', item: 'https://whatmattersbuilt.co/field-notes/' },
    { '@type': 'ListItem', position: 2, name: title, item: `https://whatmattersbuilt.co/field-notes/${a.id}/` },
  ],
};
---
<BaseLayout title={`${title} | Jerio`} description={a.data.seoDescription ?? description}>
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <article id="article" style="padding-top:64px;">
        <div class="eyebrow"><a href="/field-notes/">Field Notes</a> / {category}</div>
        <h1 class="article-title">{title}</h1>
        <p class="article-deck">{description}</p>
        <div class="article-meta">
          <span>{author}</span>
          <span>{publishedAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
          <span>{readingTime} min read</span>
        </div>
        <div class="article-body">
          <Content />
        </div>
        {relatedLinks.length > 0 && (
          <div class="article-related">
            <div class="eyebrow">Referenced in this note</div>
            <div class="related-list">
              {relatedLinks.map((link) => (
                <a href={link.href} class="related-link">{link.label}</a>
              ))}
            </div>
          </div>
        )}
        <div class="article-cta">
          <div class="eyebrow">Talk to me</div>
          <p>Working on something related? <a href="/#contact">Tell me what you're working on</a>.</p>
        </div>
      </article>
    </main>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</BaseLayout>

<style>
  .article-title{font-family:var(--serif);font-style:italic;font-weight:400;font-size:clamp(32px,5vw,52px);line-height:1.1;margin:0 0 16px;max-width:20ch;}
  .article-deck{font-size:17px;color:var(--text-dim);line-height:1.6;max-width:56ch;margin:0 0 20px;}
  .article-meta{display:flex;gap:16px;font-family:var(--mono);font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;margin-bottom:40px;padding-bottom:24px;border-bottom:1px solid var(--border-soft);}
  .article-body{font-size:16px;line-height:1.85;color:var(--text-dim);max-width:68ch;}
  .article-body :global(h2){font-family:var(--serif);font-style:italic;color:var(--text);font-size:26px;margin:40px 0 16px;}
  .article-body :global(h3){font-family:var(--serif);font-style:italic;color:var(--text);font-size:20px;margin:32px 0 12px;}
  .article-body :global(p){margin:0 0 20px;}
  .article-body :global(a){color:var(--accent);}
  .article-body :global(img){border-radius:12px;margin:24px 0;}
  .article-related{margin-top:48px;padding-top:28px;border-top:1px solid var(--border-soft);max-width:68ch;}
  .related-list{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:14px;}
  .related-link{font-family:var(--serif);font-style:italic;font-size:15px;text-decoration:none;color:var(--text-dim);border-bottom:1px solid var(--border);padding-bottom:2px;}
  .related-link:hover{color:var(--accent);border-color:var(--accent);}
  .article-cta{margin-top:56px;padding-top:28px;border-top:1px solid var(--border-soft);}
  .article-cta p{font-size:14px;color:var(--text-dim);}
  .article-cta a{color:var(--accent);border-bottom:1px solid var(--accent);text-decoration:none;}
</style>
