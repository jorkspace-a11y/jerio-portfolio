---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailNav from '../../components/nav/RailNav.astro';
import MobileBar from '../../components/nav/MobileBar.astro';

const resources = (await getCollection('resources')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Resources | Jerio" description="Free tools, calculators, and checklists, practical, not gated behind an email you don't want to give.">
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main id="main-content">
      <section id="resources-index" style="padding-top:64px;">
        <div class="eyebrow">Resources</div>
        <h1 class="head">Tools for the work.</h1>

        <div class="resources-grid">
          {resources.map((r) => (
            <a href={`/resources/${r.data.type}s/${r.data.slug}/`} class="resource-card" data-cursor="OPEN">
              <span class="resource-card-type">{r.data.type}</span>
              <span class="resource-card-title">{r.data.title}</span>
              <p class="resource-card-summary">{r.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .resources-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:36px;}
  .resource-card{display:block;background:transparent;border:0;border-top:1px solid var(--border);border-radius:0;padding:28px 0;text-decoration:none;color:inherit;transition:transform .2s ease,border-color .2s ease;}
  .resource-card:hover{transform:translateY(-2px);border-color:var(--border);}
  .resource-card-type{font-family:var(--mono);font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);}
  .resource-card-title{display:block;font-family:var(--serif);font-size:28px;margin:8px 0 6px;}
  .resource-card-summary{font-size:15px;color:var(--text-dim);line-height:1.6;margin:0;}
</style>
