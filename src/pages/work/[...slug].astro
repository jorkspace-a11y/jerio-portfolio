---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailNav from '../../components/nav/RailNav.astro';
import MobileBar from '../../components/nav/MobileBar.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ArchiveBlock from '../../components/ArchiveBlock.astro';
import { WorkCarousel } from '../../components/work/WorkCarousel';
import type { WorkMediaSlide } from '../../components/work/WorkCarousel';
import { getMediaFit, getThumbFit } from '../../lib/media-fit';

const CAROUSEL_MAX = 6;
const CAROUSEL_MIN = 4;

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((w) => ({
    params: { slug: w.id },
    props: { w, all: work },
  }));
}

const { w, all } = Astro.props;
const {
  title, organisation, role, categories, status, summary,
  context, scope, workDone, outcomes, limitations, lessons,
  media, archives, relatedServices, relatedFieldNotes, relatedResources,
} = w.data;

const related = all.filter((e) => e.id !== w.id).slice(0, 3);

// Real project media only, never stock imagery (PRD section 23.3). The
// carousel is a *selected highlights* reel, not the full archive — PRD
// "P2 UI/UX Remediation" section 13 explicitly forbids rendering the same
// media twice (carousel + ArchiveBlock showing every image). One slide per
// archive group (so the reel stays varied, not five shots from the same
// group) plus every flat `media` entry, capped at CAROUSEL_MAX. Below
// CAROUSEL_MIN there's no real "highlights vs archive" distinction worth
// making, so the carousel is skipped and the archive speaks for itself.
const onePerGroup = archives.flatMap((a) =>
  a.groups.map((g) => {
    const t = g.thumbs[0];
    return t && { image: t.src, alt: t.alt, label: g.label, fit: getThumbFit(t.fit, g.label) };
  }).filter((s): s is NonNullable<typeof s> => Boolean(s))
);
const totalArchiveAssets = archives.reduce((n, a) => n + a.groups.reduce((m, g) => m + g.thumbs.length, 0), 0);
const rawSlides: WorkMediaSlide[] = [
  ...media.map((m) => ({ image: m.src, alt: m.alt, fit: getMediaFit(m.fit, m.type) })),
  ...onePerGroup,
];
const carouselSlides: WorkMediaSlide[] = (media.length + totalArchiveAssets) >= CAROUSEL_MIN
  ? rawSlides.slice(0, CAROUSEL_MAX)
  : [];

const allServices = await getCollection('services');
const serviceLinks = relatedServices.map((slug) => {
  const entry = allServices.find((s) => s.data.slug === slug);
  if (!entry) throw new Error(`Work "${w.id}" references unknown service slug "${slug}"`);
  return { href: `/services/${entry.data.slug}/`, label: entry.data.title };
});

const allFieldNotes = await getCollection('field-notes');
const fieldNoteLinks = relatedFieldNotes.map((id) => {
  const entry = allFieldNotes.find((n) => n.id === id);
  if (!entry) throw new Error(`Work "${w.id}" references unknown field note id "${id}"`);
  return { href: `/field-notes/${entry.id}/`, label: entry.data.title };
});

const allResources = await getCollection('resources');
const resourceLinks = relatedResources.map((slug) => {
  const entry = allResources.find((r) => r.data.slug === slug);
  if (!entry) throw new Error(`Work "${w.id}" references unknown resource slug "${slug}"`);
  return { href: `/resources/${entry.data.type}s/${entry.data.slug}/`, label: entry.data.title };
});

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Work', item: 'https://whatmattersbuilt.co/work/' },
    { '@type': 'ListItem', position: 2, name: title, item: `https://whatmattersbuilt.co/work/${w.id}/` },
  ],
};

const workJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description: `${role ? `${role} for ${organisation}. ` : ''}${summary}`,
  creator: { '@type': 'Person', name: 'Jerio' },
  about: organisation,
  keywords: categories.join(', '),
  url: `https://whatmattersbuilt.co/work/${w.id}/`,
};
---
<BaseLayout title={`${title} | Jerio`} description={`${role ? `${role} for ${organisation}. ` : ''}${summary}`}>
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <section id="work-detail" data-work-id={w.id} style="padding-top:64px;">
        <div class="eyebrow"><a href="/work/">Work</a> / {title}</div>
        <h1 class="work-title">{title}</h1>
        <div class="work-meta">
          {organisation !== title && <div><span class="lbl">Organisation</span><span>{organisation}</span></div>}
          {role && <div><span class="lbl">Role</span><span>{role}</span></div>}
          <div><span class="lbl">Category</span><span>{categories.join(', ')}</span></div>
          <div class="lbl-status"><StatusBadge status={status} /></div>
        </div>

        <p class="work-summary">{summary}</p>

        {context && <div class="work-block"><div class="lbl">Context</div><p>{context}</p></div>}

        {scope.length > 0 && (
          <div class="work-block"><div class="lbl">Scope</div><ul>{scope.map((s) => <li>{s}</li>)}</ul></div>
        )}

        {workDone.map((w2) => (
          <div class="work-block"><div class="lbl">Work</div><p>{w2}</p></div>
        ))}

        {outcomes.length > 0 && (
          <div class="work-block">
            <div class="lbl">Outcomes</div>
            <div class="outcomes-grid">
              {outcomes.map((o) => (
                <div class="outcome">
                  <span class="outcome-value">{o.value}</span>
                  <span class="outcome-label">{o.label}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {limitations.length > 0 && (
          <div class="work-block"><div class="lbl">Limitations</div><ul>{limitations.map((l) => <li>{l}</li>)}</ul></div>
        )}

        {lessons.length > 0 && (
          <div class="work-block lesson">{lessons.map((l) => <p>{l}</p>)}</div>
        )}

        {carouselSlides.length > 0 && (
          <div class="work-block carousel-block">
            <div class="lbl">Media</div>
            <WorkCarousel slides={carouselSlides} client:visible />
          </div>
        )}

        {archives.map((a) => <ArchiveBlock title={a.title} groups={a.groups} />)}

        {(serviceLinks.length > 0 || fieldNoteLinks.length > 0 || resourceLinks.length > 0) && (
          <div class="related">
            <div class="eyebrow">Related</div>
            <div class="related-list">
              {[...serviceLinks, ...fieldNoteLinks, ...resourceLinks].map((link) => (
                <a href={link.href} class="related-link">{link.label}</a>
              ))}
            </div>
          </div>
        )}

        {related.length > 0 && (
          <div class="related">
            <div class="eyebrow">More Work</div>
            <div class="related-list">
              {related.map((r) => (
                <a href={`/work/${r.id}/`} class="related-link">{r.data.title}</a>
              ))}
            </div>
          </div>
        )}
      </section>
    </main>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(workJsonLd)} />
</BaseLayout>

<script>
  import { trackEvent } from '../../scripts/analytics';

  const section = document.getElementById('work-detail');
  trackEvent('work_view', { work: section?.dataset.workId });
</script>

<style>
  /* P2 remediation, Direction B (Utilitarian + restrained Neo-Brutalism) +
     Typography System 3 (Modular utility): Work titles move from italic
     Cormorant to weighted mono, active/emphasis states lean on the red
     underline rather than a filled pill. Scoped to Work surfaces only. */
  .work-title{font-family:var(--mono);font-weight:500;font-size:clamp(28px,4vw,42px);line-height:1.08;letter-spacing:-.01em;margin:14px 0 24px;max-width:22ch;}
  .work-meta{display:flex;flex-wrap:wrap;align-items:center;gap:24px 32px;margin-bottom:28px;padding-bottom:28px;border-bottom:1px solid var(--border-soft);}
  .work-meta > div{display:flex;flex-direction:column;gap:4px;}
  .work-meta .lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-faint);}
  .work-meta > div > span:last-child{font-size:14px;color:var(--text);}
  .work-summary{font-size:16px;color:var(--text-dim);line-height:1.7;max-width:62ch;margin:0 0 28px;}
  .work-block{margin-bottom:24px;}
  .work-block .lbl{font-family:var(--mono);font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-faint);margin-bottom:8px;}
  .work-block p{font-size:14px;line-height:1.75;color:var(--text-dim);margin:0 0 10px;max-width:62ch;}
  .work-block ul{margin:0;padding-left:18px;}
  .work-block li{font-size:14px;line-height:1.75;color:var(--text-dim);}
  .work-block.lesson p{font-family:var(--serif);font-style:italic;color:var(--text);font-size:16px;}
  .outcomes-grid{display:flex;flex-wrap:wrap;gap:20px 32px;}
  .outcome{display:flex;flex-direction:column;gap:2px;}
  .outcome-value{font-family:var(--mono);font-weight:500;font-size:22px;color:var(--accent);}
  .outcome-label{font-size:11.5px;color:var(--text-dim);max-width:24ch;}
  .carousel-block{padding-bottom:32px;}
  .related{margin-top:48px;padding-top:28px;border-top:1px solid var(--border-soft);}
  .related-list{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:14px;}
  .related-link{font-family:var(--mono);font-size:13px;text-decoration:none;color:var(--text-dim);border-bottom:2px solid var(--border);padding-bottom:2px;transition:color .15s ease,border-color .15s ease;}
  .related-link:hover{color:var(--accent);border-color:var(--accent);}
</style>
