---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailNav from '../../components/nav/RailNav.astro';
import MobileBar from '../../components/nav/MobileBar.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { WorkPreviewManager } from '../../components/work/WorkPreviewManager';
import { CATEGORIES } from '../../data/taxonomy';
import { getThumbFit, getMediaFit } from '../../lib/media-fit';
import type { WorkPreviewItem } from '../../components/work/WorkPreviewManager';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

// Filter buttons are derived from the canonical taxonomy (src/data/taxonomy.ts),
// narrowed to categories with at least one published entry — never a second
// hand-written list. The underlying taxonomy stays canonical even when a
// category is temporarily hidden for lack of content.
const usedCategories = new Set(work.flatMap((item) => item.data.categories));
const visibleCategories = CATEGORIES.filter((c) => usedCategories.has(c));

// Preview data: one real image per item when one exists (first archive
// thumb, or first media entry), never a stock placeholder — a text-only
// preview is the honest fallback for items with no media (PRD 23.3).
const previewItems: WorkPreviewItem[] = work.map((w) => {
  const firstThumb = w.data.archives[0]?.groups[0]?.thumbs[0];
  const firstThumbGroup = w.data.archives[0]?.groups[0]?.label;
  const firstMedia = w.data.media[0];
  const image = firstMedia
    ? { src: firstMedia.src, alt: firstMedia.alt, fit: getMediaFit(firstMedia.fit, firstMedia.type) }
    : firstThumb
    ? { src: firstThumb.src, alt: firstThumb.alt, fit: getThumbFit(firstThumb.fit, firstThumbGroup ?? '') }
    : undefined;
  return {
    id: w.id,
    title: w.data.title,
    organisation: w.data.organisation,
    role: w.data.role,
    summary: w.data.summary,
    categories: w.data.categories,
    status: w.data.status,
    image,
  };
});
---
<BaseLayout title="Work | Jerio" description="Every project, filterable by discipline: strategy, growth, marketing, brand, operations, and systems work by Jerio.">
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <section id="work-archive" style="padding-top:64px;">
        <div class="eyebrow">Work</div>
        <h1 class="head">Every project, one archive.</h1>

        <div class="filters" role="group" aria-label="Filter by category">
          <button type="button" class="filter-btn active" data-filter="All">All</button>
          {visibleCategories.map((c) => (
            <button type="button" class="filter-btn" data-filter={c}>{c}</button>
          ))}
        </div>

        <noscript>
          <p class="filter-noscript">Filters need JavaScript. Every project is listed below regardless.</p>
        </noscript>

        <div class="work-shell">
          <div class="work-list" id="work-list">
            {work.map((w) => (
              <a
                href={`/work/${w.id}/`}
                class="work-row"
                data-work-row={w.id}
                data-categories={JSON.stringify(w.data.categories)}
                data-cursor="VIEW"
              >
                <span class="work-row-title">{w.data.title}</span>
                <span class="work-row-meta">
                  {w.data.categories.join(', ')}
                  {w.data.organisation !== w.data.title && ` · ${w.data.organisation}`}
                </span>
                <StatusBadge status={w.data.status} />
                <span class="work-row-arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>

          <WorkPreviewManager items={previewItems} client:load />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  /* P2 remediation, Direction B (Utilitarian + restrained Neo-Brutalism):
     text-tab filters with an underline active state, not filled pills. */
  .filters{display:flex;flex-wrap:wrap;gap:20px;margin-bottom:36px;border-bottom:1px solid var(--border-soft);}
  .filter-btn{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dimmer);background:transparent;border:none;padding:0 0 12px;cursor:pointer;position:relative;}
  .filter-btn:hover{color:var(--text);}
  .filter-btn.active{color:var(--text);}
  .filter-btn.active::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--accent);}
  .filter-noscript{font-size:13px;color:var(--text-dimmer);margin-bottom:24px;}

  /* Interactive Work Index: list + sticky preview, replaces the repeated
     card grid entirely (PRD "P2 UI/UX Remediation" section 5-7). */
  .work-shell{display:grid;grid-template-columns:60% 1fr;gap:40px;align-items:start;}
  @media (max-width:900px){.work-shell{grid-template-columns:1fr;}}

  .work-list{display:flex;flex-direction:column;}
  .work-row{
    display:grid;grid-template-columns:1fr auto auto auto;align-items:center;gap:18px;
    padding:18px 4px;border-bottom:1px solid var(--border-soft);
    text-decoration:none;color:inherit;background:none;
  }
  .work-row-title{font-family:var(--mono);font-weight:500;font-size:19px;transition:color .12s ease;}
  .work-row-meta{font-family:var(--mono);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--text-faint);}
  .work-row-arrow{color:var(--accent);opacity:0;transition:opacity .12s ease,transform .12s ease;}
  .work-row:hover,.work-row:focus-visible{outline:none;}
  .work-row:hover .work-row-title,.work-row:focus-visible .work-row-title{color:var(--accent);}
  .work-row:hover .work-row-arrow,.work-row:focus-visible .work-row-arrow{opacity:1;transform:translateX(2px);}
  .work-row.is-hidden{display:none;}
  @media (max-width:640px){
    .work-row{grid-template-columns:1fr auto;row-gap:6px;}
    .work-row-meta{grid-column:1 / -1;}
  }
</style>

<script>
  import { trackEvent } from '../../scripts/analytics';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const rows = document.querySelectorAll<HTMLElement>('.work-row');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      trackEvent('work_filter_used', { filter });
      let firstVisible: HTMLElement | null = null;
      rows.forEach((row) => {
        const cats = JSON.parse(row.dataset.categories ?? '[]') as string[];
        const match = filter === 'All' || cats.includes(filter ?? '');
        row.classList.toggle('is-hidden', !match);
        if (match && !firstVisible) firstVisible = row;
      });
      // If the previewed project just got filtered out, move the preview to
      // the first still-visible row instead of showing a hidden project
      // (PRD 14.2: "if the currently previewed project becomes hidden,
      // preview must change").
      if (firstVisible) (firstVisible as HTMLElement).dispatchEvent(new Event('mouseenter'));
    });
  });
</script>
