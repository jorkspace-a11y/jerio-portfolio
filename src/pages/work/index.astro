---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RailNav from '../../components/nav/RailNav.astro';
import MobileBar from '../../components/nav/MobileBar.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { CATEGORIES } from '../../data/taxonomy';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

// Filter buttons are derived from the canonical taxonomy (src/data/taxonomy.ts),
// narrowed to categories with at least one published entry — never a second
// hand-written list. The underlying taxonomy stays canonical even when a
// category is temporarily hidden for lack of content.
const usedCategories = new Set(work.flatMap((item) => item.data.categories));
const visibleCategories = CATEGORIES.filter((c) => usedCategories.has(c));
---
<BaseLayout title="Work | Jerio" description="Every project, filterable by discipline — strategy, growth, marketing, brand, operations, and systems work by Jerio.">
  <MobileBar />
  <div class="shell">
    <RailNav />
    <main>
      <section id="work-archive" style="padding-top:64px;">
        <div class="eyebrow">Work</div>
        <h1 class="head">Every project, one archive.</h1>

        <div class="filters" role="group" aria-label="Filter by category">
          <button type="button" class="filter-btn active" data-filter="All">All</button>
          {visibleCategories.map((c) => (
            <button type="button" class="filter-btn" data-filter={c}>{c}</button>
          ))}
        </div>

        <noscript>
          <p class="filter-noscript">Filters need JavaScript. Every project is listed below regardless.</p>
        </noscript>

        <div class="archive-grid">
          {work.map((w) => (
            <a
              href={`/work/${w.id}/`}
              class="archive-card"
              data-cursor="VIEW"
              data-categories={JSON.stringify(w.data.categories)}
            >
              <div class="archive-card-head">
                <span class="archive-card-title">{w.data.title}</span>
                <StatusBadge status={w.data.status} />
              </div>
              <div class="archive-card-org">{w.data.organisation}{w.data.industry ? ` · ${w.data.industry}` : ''}</div>
              <p class="archive-card-role">{w.data.role ?? w.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:32px;}
  .filter-btn{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-dimmer);background:transparent;border:1px solid var(--border);border-radius:20px;padding:8px 16px;cursor:pointer;transition:color .15s ease,border-color .15s ease,background .15s ease;}
  .filter-btn:hover{color:var(--text);border-color:var(--accent);}
  .filter-btn.active{color:var(--bg);background:var(--accent);border-color:var(--accent);}
  .filter-noscript{font-size:13px;color:var(--text-dimmer);margin-bottom:24px;}
  .archive-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;}
  .archive-card{display:block;background:var(--surface);border:1px solid var(--border-soft);border-radius:16px;padding:24px 22px;text-decoration:none;color:inherit;transition:transform .2s ease,border-color .2s ease;}
  .archive-card:hover{transform:translateY(-2px);border-color:var(--border);}
  .archive-card.is-hidden{display:none;}
  .archive-card-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  .archive-card-title{font-family:var(--serif);font-style:italic;font-size:17px;}
  .archive-card-org{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--text-faint);margin:10px 0;}
  .archive-card-role{font-size:12.5px;color:var(--text-dim);line-height:1.6;margin:0;}
</style>

<script>
  import { trackEvent } from '../../scripts/analytics';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.archive-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      trackEvent('work_filter_used', { filter });
      cards.forEach((card) => {
        const cats = JSON.parse(card.dataset.categories ?? '[]') as string[];
        const match = filter === 'All' || cats.includes(filter ?? '');
        card.classList.toggle('is-hidden', !match);
      });
    });
  });
</script>
